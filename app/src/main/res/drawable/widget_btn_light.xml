<?xml version="1.0" encoding="utf-8"?>
<!-- v48.32: the widget's Vol - / + and Skip Ad buttons — the
     same pill shape and 48 dp radius as the Power pill
     drawables, in white, so all four buttons in the row read
     as one balanced control bar. (The default Button
     background is pill-like on Samsung but a fixed-radius
     shape of its own, so it would not match the Power pill
     at taller widget heights.) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="48dp" />
</shape>
