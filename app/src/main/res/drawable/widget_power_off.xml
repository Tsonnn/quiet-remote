<?xml version="1.0" encoding="utf-8"?>
<!-- v48.32: widget Power button, TV off — pill shape in the same
     soft red as TvRegistry.widgetPowerColor (0xFFE57373). See
     widget_power_on.xml for why this is a drawable, not a flat
     background color. -->
